# Required secrets (use a distinct, random 32-byte-or-longer value in every environment)
JWT_SECRET=replace-with-a-random-32-byte-minimum-secret
MYSQL_USERNAME=smartops
MYSQL_PASSWORD=replace-with-a-strong-database-password
GEMINI_API_KEY=replace-with-provider-api-key

# Production endpoints. Values below are examples only.
MYSQL_URL=jdbc:mysql://mysql:3306/smartops_auth
MONITORING_MONGODB_URI=mongodb://mongo:27017/smartops_monitor
ALERT_MONGODB_URI=mongodb://mongo:27017/smartops_alert_db
INSIGHT_MONGODB_URI=mongodb://mongo:27017/smartops_insights
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
EUREKA_DEFAULT_ZONE=http://service-registry:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=service-name
CORS_ALLOWED_ORIGINS=https://dashboard.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax
JPA_DDL_AUTO=validate
MONITORING_POLLING_RATE=30000

# Public browser configuration only. Never put credentials or signing keys here.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_MONITORING_WS_URL=https://api.example.com/monitor-ws
